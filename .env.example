# ---- Application -----------------------------------------------------------
APP_NAME=AI Website Link Analysis API
APP_ENV=development
PORT=4000
LOG_LEVEL=INFO
# Set to true ONLY behind a trusted reverse proxy (Render): uses X-Forwarded-For for rate limiting.
TRUST_PROXY_HEADERS=false
# Requests per minute per client on POST /link-analysis (0 disables). Protects your LLM budget.
RATE_LIMIT_PER_MINUTE=10
# Maximum request body size in bytes (the body is a tiny JSON object).
MAX_REQUEST_BYTES=8192

# ---- LLM (primary: Google Gemini; rationale in docs/LLM_RESEARCH.md) ---------
LLM_PROVIDER=gemini
# Leave blank to use the provider default (gemini-3.8-flash).
LLM_MODEL=
# Create a key at https://aistudio.google.com/api-keys  (never commit a real key)
GEMINI_API_KEY=
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
# low | medium | high  (blank = omit; use blank for models without thinking levels)
LLM_THINKING_LEVEL=low
# Optional: per-1M-token USD prices to show an *estimated* cost in response metadata.
# Gemini 3.8 Flash standard: 0.75 / 3.75 through 2026-12-31, then 1.50 / 7.50 (see docs/LLM_RESEARCH.md).
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=
# Characters of cleaned page text sent to the LLM (cost control).
LLM_PROMPT_MAX_CHARS=24000

# ---- Optional: verified competitor research (https://app.tavily.com, 1,000 free credits/month) ----
TAVILY_API_KEY=

# ---- Website extraction ------------------------------------------------------
# Overall time budget (seconds) for fetching a page, including redirects.
REQUEST_TIMEOUT=20
# Max characters of page text kept after cleaning.
MAX_CONTENT_LENGTH=50000
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=3000000

# ---- Result cache (in-memory, per process; 0 disables) -------------------------
CACHE_TTL_SECONDS=900
